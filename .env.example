# Copy to .env and change the passwords:  cp .env.example .env
# .env is git-ignored. Never commit real credentials or API keys.

# --- API (read by app.core.config.Settings, prefix CONTEXTLEDGER_) ---------
CONTEXTLEDGER_ENVIRONMENT=local
# api (default) or batch: a one-shot job that only needs PostgreSQL + embeddings (Phase 24)
CONTEXTLEDGER_PROCESS_ROLE=api
CONTEXTLEDGER_LOG_LEVEL=INFO
CONTEXTLEDGER_LOG_JSON=true
CONTEXTLEDGER_DOCS_ENABLED=true
API_PORT=8000

# Database connection used when the API or Alembic runs on your Mac
# (make run, make migrate). Must match the POSTGRES_* values below.
# Inside Docker Compose the API gets these from POSTGRES_* automatically.
CONTEXTLEDGER_DB_HOST=localhost
CONTEXTLEDGER_DB_PORT=5432
CONTEXTLEDGER_DB_USER=contextledger
CONTEXTLEDGER_DB_PASSWORD=change-me-local-only
CONTEXTLEDGER_DB_NAME=contextledger

# --- Embeddings --------------------------------------------------------------
# "deterministic" works offline with no key (word-overlap hashing, NOT semantic).
# For real semantic embeddings set provider=openai and your key (costs money).
CONTEXTLEDGER_EMBEDDING_PROVIDER=deterministic
CONTEXTLEDGER_EMBEDDING_MODEL=text-embedding-3-small
CONTEXTLEDGER_OPENAI_API_KEY=
# LLM generation (grounded answers, agent). "disabled" makes no model calls;
# "openai" needs CONTEXTLEDGER_OPENAI_API_KEY and costs money per request.
CONTEXTLEDGER_LLM_PROVIDER=disabled
CONTEXTLEDGER_OPENAI_CHAT_MODEL=gpt-4o-mini
CONTEXTLEDGER_LLM_TIMEOUT_SECONDS=30
CONTEXTLEDGER_LLM_MAX_RETRIES=2
CONTEXTLEDGER_LLM_MAX_OUTPUT_TOKENS=800

# --- PostgreSQL + pgvector ---------------------------------------------------
# Avoid $, #, quotes and spaces in passwords: the Makefile also reads this file.
POSTGRES_USER=contextledger
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=contextledger
POSTGRES_PORT=5432

# --- Redis -------------------------------------------------------------------
# Keep it URL-safe (letters, digits, - _ .): the API connects with redis://:<password>@...
REDIS_PASSWORD=change-me-local-only
REDIS_PORT=6379
# For `make run` on your Mac, point the API at the Compose Redis; leave empty
# for a per-process in-memory store (fine for one local process only).
CONTEXTLEDGER_REDIS_URL=

# --- Neo4j (password must be at least 8 characters) --------------------------
NEO4J_PASSWORD=change-me-local-only
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# --- Kafka ------------------------------------------------------------------
KAFKA_PORT=9092

# --- MCP server (python -m app.mcp.server) -----------------------------------
# The organization and user the local MCP server acts as (ids from your database).
# CONTEXTLEDGER_MCP_ORGANIZATION_ID=00000000-0000-0000-0000-000000000000
# CONTEXTLEDGER_MCP_USER_ID=00000000-0000-0000-0000-000000000000
CONTEXTLEDGER_MCP_AGENT_NAME=local-agent
CONTEXTLEDGER_MCP_MAX_PRIVACY_SCOPE=INTERNAL

# --- API authentication -----------------------------------------------------------
# development-headers (local only) or jwt. Bearer tokens are accepted in both modes.
CONTEXTLEDGER_AUTH_MODE=development-headers
# ES256 private key in PEM (`make jwt-key`). Empty locally: an ephemeral key is used.
# CONTEXTLEDGER_JWT_SIGNING_KEY=

# --- Observability (make obs-up: Prometheus :9090, Grafana :3001, Jaeger :16686) ---
GRAFANA_ADMIN_PASSWORD=change-me-local-only
# Traces from the API container: http://jaeger:4318 ; from `make run` on your Mac: http://localhost:4318
# CONTEXTLEDGER_OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
# Required in staging/production (Prometheus then sends it as a bearer token).
# CONTEXTLEDGER_METRICS_TOKEN=
