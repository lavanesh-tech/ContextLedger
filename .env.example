# Copy to .env and change the passwords:  cp .env.example .env
# .env is git-ignored. Never commit real credentials or API keys.

# --- API (read by app.core.config.Settings, prefix CONTEXTLEDGER_) ---------
CONTEXTLEDGER_ENVIRONMENT=local
CONTEXTLEDGER_LOG_LEVEL=INFO
CONTEXTLEDGER_LOG_JSON=true
CONTEXTLEDGER_DOCS_ENABLED=true
API_PORT=8000

# Database connection used when the API or Alembic runs on your Mac
# (make run, make migrate). Must match the POSTGRES_* values below.
# Inside Docker Compose the API gets these from POSTGRES_* automatically.
CONTEXTLEDGER_DB_HOST=localhost
CONTEXTLEDGER_DB_PORT=5432
CONTEXTLEDGER_DB_USER=contextledger
CONTEXTLEDGER_DB_PASSWORD=change-me-local-only
CONTEXTLEDGER_DB_NAME=contextledger

# --- PostgreSQL + pgvector ---------------------------------------------------
# Avoid $, #, quotes and spaces in passwords: the Makefile also reads this file.
POSTGRES_USER=contextledger
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=contextledger
POSTGRES_PORT=5432

# --- Redis -------------------------------------------------------------------
REDIS_PASSWORD=change-me-local-only
REDIS_PORT=6379

# --- Neo4j (password must be at least 8 characters) --------------------------
NEO4J_PASSWORD=change-me-local-only
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# --- Kafka ------------------------------------------------------------------
KAFKA_PORT=9092
