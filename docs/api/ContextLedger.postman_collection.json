              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "organizations",
                "{{organization_id}}",
                "facts"
              ]
            },
            "description": "Source S says: entity E's property P has value V from `valid_from`.\n\nSupersedes the current version when `valid_from` is later; the database\nguarantees versions of one fact never overlap in valid time.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"entity_type\": \"customer\",\n  \"external_id\": \"customer-991\",\n  \"property\": \"credit_limit\",\n  \"value\": 5000,\n  \"source_id\": \"{{source_id}}\",\n  \"valid_from\": \"2026-01-15T09:00:00Z\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Facts of an entity at a point in time",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-ContextLedger-User-Id",
                "value": "{{userId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/organizations/{{organization_id}}/entities/{{entity_type}}/{{external_id}}/facts?valid_at=&known_at=",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "organizations",
                "{{organization_id}}",
                "entities",
                "{{entity_type}}",
                "{{external_id}}",
                "facts"
              ],
              "query": [
                {
                  "key": "valid_at",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "known_at",
                  "value": "",
                  "disabled": true
                }
              ]
            },
            "description": "Values valid at `valid_at` (default: now) as known at `known_at` (default: latest)."
