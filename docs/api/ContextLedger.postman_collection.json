    {
      "name": "auth",
      "item": [
        {
          "name": "OAuth2 token endpoint (client credentials)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-ContextLedger-User-Id",
                "value": "{{userId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/oauth/token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "oauth",
                "token"
              ]
            },
            "description": "Exchange an agent's client credentials for a short-lived, scoped access token.\n\nLimited per client_id (whether or not it exists), which caps secret guessing."
          }
        },
        {
          "name": "Issue a user token (local and test environments only)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-ContextLedger-User-Id",
                "value": "{{userId}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/dev-token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "dev-token"
              ]
            },
            "description": "Human sign-in via an external identity provider is out of scope for this project;\nthis endpoint lets developers obtain a user token locally. It does not exist\n(404) in staging or production.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": \"{{user_id}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
